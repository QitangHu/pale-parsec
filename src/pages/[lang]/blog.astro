---
import ContentPage from '../../components/ContentPage.astro';
import { localizedLocales } from '../../i18n/ui';

export function getStaticPaths() {
  return localizedLocales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang;
if (!lang) throw new Error('Missing locale for localized blog page.');
---

<ContentPage page="blog" lang={lang} />